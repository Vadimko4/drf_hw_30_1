# Создайте файл .env из копии этого файла и замените значения переменных реальными данными

# django secret_key
SECRET_KEY = your_secret_key
DEBUG=your_choice


# Настройки для БД postgreSQL
NAME=your_DB_name
USER=your_username
PASSWORD=your_password
HOST=your_host
PORT=your_port

STRIPE_API_KEY=your_api_key

CELERY_BROKER_URL=you_broker_url
CELERY_RESULT_BACKEND=you_result_url